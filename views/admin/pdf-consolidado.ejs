<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <title>
        <%= titulo %>
    </title>

    <style>

        /* ===================================================== */
        /* PÁGINA                                                */
        /* ===================================================== */

        @page {
            size: A4 landscape;
            margin: 10mm;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 10px;
            margin: 0;
            color: #263238;
            line-height: 1.25;
        }


        /* ===================================================== */
        /* CABEÇALHO                                             */
        /* ===================================================== */

        h1 {
            font-size: 20px;
            color: #0056b3;

            text-align: center;

            margin:
                0 0 18px 0;

            padding-bottom: 8px;

            border-bottom:
                2px solid #0056b3;
        }


        /* ===================================================== */
        /* CATEGORIA                                             */
        /* ===================================================== */

        .categoria-section {
            margin-bottom: 22px;

            page-break-inside: auto;
            break-inside: auto;
        }


        .categoria-header {
            margin:
                0 0 7px 0;

            padding:
                7px 10px;

            background-color:
                #f0f7ff;

            border-left:
                4px solid #007bff;

            font-size: 14px;

            font-weight: bold;

            color: #0056b3;

            text-transform: uppercase;
        }


        /* ===================================================== */
        /* TABELA                                                */
        /* ===================================================== */

        .projetos-table {
            width: 100%;

            border-collapse:
                collapse;

            table-layout:
                auto;

            background-color:
                #ffffff;

            font-size:
                9px;
        }


        .projetos-table th,
        .projetos-table td {

            border:
                1px solid #9ea7ad;

            padding:
                5px 4px;

            vertical-align:
                middle;
        }


        /* ===================================================== */
        /* CABEÇALHO DA TABELA                                   */
        /* ===================================================== */

        .projetos-table thead {
            display:
                table-header-group;
        }


        .projetos-table thead th {

            background-color:
                #e4f1fb;

            color:
                #004f87;

            font-weight:
                bold;

            font-size:
                8px;

            text-align:
                center;

            text-transform:
                uppercase;

            white-space:
                normal;

            line-height:
                1.15;
        }


        /* ===================================================== */
        /* LINHAS                                                */
        /* ===================================================== */

        .projetos-table tbody tr {
            page-break-inside:
                avoid;

            break-inside:
                avoid;
        }


        .projetos-table tbody tr:nth-child(even) {
            background-color:
                #f8fafc;
        }


        /* ===================================================== */
        /* COLUNAS FIXAS                                         */
        /* ===================================================== */

        .col-posicao {
            width:
                48px;

            min-width:
                48px;

            text-align:
                center;
        }


        .col-estande {
            width:
                55px;

            min-width:
                55px;

            text-align:
                center;
        }


        .col-projeto {
            min-width:
                180px;

            text-align:
                left;
        }


        .col-avaliacoes {
            width:
                65px;

            min-width:
                65px;

            text-align:
                center;
        }


        /* ===================================================== */
        /* CRITÉRIOS                                             */
        /* ===================================================== */

        .col-criterio {
            min-width:
                70px;

            text-align:
                center;
        }


        .nota-criterio {
            text-align:
                center;

            font-weight:
                600;

            color:
                #263238;
        }


        .criterio-nao-utilizado {
            text-align:
                center;

            color:
                #a0a0a0;
        }


        .criterio-sem-avaliacao {
            text-align:
                center;

            color:
                #777;

            font-style:
                italic;
        }


        /* ===================================================== */
        /* POSIÇÃO                                               */
        /* ===================================================== */

        .posicao {
            text-align:
                center;

            font-weight:
                bold;

            color:
                #d9534f;

            font-size:
                10px;
        }


        /* ===================================================== */
        /* ESTANDE                                               */
        /* ===================================================== */

        .estande {
            text-align:
                center;

            font-weight:
                bold;
        }


        /* ===================================================== */
        /* PROJETO                                               */
        /* ===================================================== */

        .projeto-titulo {
            font-weight:
                600;

            color:
                #1f2937;
        }


        /* ===================================================== */
        /* MÉDIA GERAL                                          */
        /* ===================================================== */

        .col-media {
            width:
                70px;

            min-width:
                70px;

            text-align:
                center;

            background-color:
                #fff2bf !important;
        }


        .media-geral {
            color:
                #0056b3;

            font-weight:
                bold;

            font-size:
                10px;
        }


        /* ===================================================== */
        /* SEM DADOS                                             */
        /* ===================================================== */

        .no-data-message {

            text-align:
                center;

            margin-top:
                40px;

            padding:
                20px;

            color:
                #666;

            font-style:
                italic;

            background-color:
                #f2f2f2;

            border:
                1px solid #ddd;

            border-radius:
                5px;
        }


        /* ===================================================== */
        /* LEGENDA                                               */
        /* ===================================================== */

        .legenda {
            font-size:
                8px;

            color:
                #666;

            margin-top:
                5px;
        }


        /* ===================================================== */
        /* IMPRESSÃO                                             */
        /* ===================================================== */

        @media print {

            body {
                margin: 0;
            }


            .categoria-header {
                page-break-after:
                    avoid;
            }


            .projetos-table {
                page-break-before:
                    avoid;
            }

        }

    </style>
</head>


<body>

    <h1>
        Relatório Consolidado - <%= nomeFeira %>
    </h1>


    <%
        const sortedCategories =
            Object
                .keys(relatorioFinalPorProjeto)
                .sort((a, b) =>
                    a.localeCompare(
                        b,
                        'pt-BR',
                        {
                            numeric: true
                        }
                    )
                );
    %>


    <% if (sortedCategories.length > 0) { %>


        <% sortedCategories.forEach(categoria => { %>


            <%
                /* ============================================= */
                /* PROJETOS DA CATEGORIA                         */
                /* ============================================= */

                const projetosCategoria =
                    Array.isArray(
                        relatorioFinalPorProjeto[categoria]
                    )
                        ? relatorioFinalPorProjeto[categoria]
                        : [];


                /* ============================================= */
                /* DESCOBRIR OS CRITÉRIOS UTILIZADOS NA          */
                /* CATEGORIA                                     */
                /*                                               */
                /* É UMA UNIÃO DOS CRITÉRIOS DOS PROJETOS.       */
                /* ASSIM, SE UM PROJETO POSSUI UM CRITÉRIO        */
                /* DIFERENTE, ELE TAMBÉM GANHA UMA COLUNA.        */
                /* ============================================= */

                const criteriosMap =
                    new Map();


                projetosCategoria.forEach(projeto => {

                    const criteriosProjeto =
                        Array.isArray(projeto.criterios)
                            ? projeto.criterios
                            : [];


                    criteriosProjeto.forEach(criterio => {

                        if (!criterio) {
                            return;
                        }


                        const criterioId =
                            String(
                                criterio._id ||
                                criterio
                            );


                        if (
                            !criteriosMap.has(
                                criterioId
                            )
                        ) {

                            criteriosMap.set(
                                criterioId,
                                criterio
                            );
                        }

                    });

                });


                /* ============================================= */
                /* ORDENAR CRITÉRIOS                              */
                /*                                               */
                /* Primeiro usa ordemDesempate quando houver.     */
                /* Depois nome.                                   */
                /* ============================================= */

                const criteriosCategoria =
                    Array
                        .from(
                            criteriosMap.values()
                        )
                        .sort((a, b) => {

                            const ordemA =
                                Number(
                                    a.ordemDesempate
                                ) || 9999;


                            const ordemB =
                                Number(
                                    b.ordemDesempate
                                ) || 9999;


                            if (
                                ordemA !== ordemB
                            ) {

                                return (
                                    ordemA -
                                    ordemB
                                );
                            }


                            return String(
                                a.nome || ''
                            ).localeCompare(
                                String(
                                    b.nome || ''
                                ),
                                'pt-BR'
                            );

                        });
            %>


            <div class="categoria-section">


                <!-- ========================================= -->
                <!-- CATEGORIA                                 -->
                <!-- ========================================= -->

                <h2 class="categoria-header">
                    <%= categoria %>
                </h2>


                <table class="projetos-table">


                    <!-- ===================================== -->
                    <!-- CABEÇALHO                             -->
                    <!-- ===================================== -->

                    <thead>

                        <tr>

                            <th class="col-posicao">
                                Posição
                            </th>


                            <th class="col-estande">
                                Estande
                            </th>


                            <th class="col-projeto">
                                Projeto
                            </th>


                            <th class="col-avaliacoes">
                                Nº Aval.
                            </th>


                            <% criteriosCategoria.forEach(criterio => { %>

                                <th class="col-criterio">

                                    <%= criterio.nome || 'Critério' %>

                                </th>

                            <% }); %>


                            <th class="col-media">
                                Média Geral
                            </th>

                        </tr>

                    </thead>


                    <!-- ===================================== -->
                    <!-- PROJETOS                              -->
                    <!-- ===================================== -->

                    <tbody>


                        <% projetosCategoria.forEach((projeto, index) => { %>


                            <%
                                /* ================================= */
                                /* IDS DOS CRITÉRIOS DESTE PROJETO   */
                                /* ================================= */

                                const criteriosProjeto =
                                    Array.isArray(
                                        projeto.criterios
                                    )
                                        ? projeto.criterios
                                        : [];


                                const criteriosProjetoIds =
                                    new Set(
                                        criteriosProjeto.map(
                                            criterio =>
                                                String(
                                                    criterio._id ||
                                                    criterio
                                                )
                                        )
                                    );
                            %>


                            <tr>


                                <!-- ============================= -->
                                <!-- POSIÇÃO                       -->
                                <!-- ============================= -->

                                <td class="col-posicao posicao">

                                    <%= index + 1 %>º

                                </td>


                                <!-- ============================= -->
                                <!-- ESTANDE                       -->
                                <!-- ============================= -->

                                <td class="col-estande estande">

                                    <% if (
                                        projeto.numeroEstande !== undefined &&
                                        projeto.numeroEstande !== null &&
                                        projeto.numeroEstande !== ''
                                    ) { %>

                                        <%= projeto.numeroEstande %>

                                    <% } else { %>

                                        <span style="color:#999;">
                                            -
                                        </span>

                                    <% } %>

                                </td>


                                <!-- ============================= -->
                                <!-- PROJETO                       -->
                                <!-- ============================= -->

                                <td class="col-projeto projeto-titulo">

                                    <%= projeto.titulo %>

                                </td>


                                <!-- ============================= -->
                                <!-- Nº AVALIAÇÕES                  -->
                                <!-- ============================= -->

                                <td class="col-avaliacoes">

                                    <%= projeto.numAvaliacoes %>

                                </td>


                                <!-- ============================= -->
                                <!-- CRITÉRIOS DINÂMICOS            -->
                                <!-- ============================= -->

                                <% criteriosCategoria.forEach(criterio => { %>


                                    <%
                                        const criterioId =
                                            String(
                                                criterio._id ||
                                                criterio
                                            );


                                        const projetoUsaCriterio =
                                            criteriosProjetoIds.has(
                                                criterioId
                                            );


                                        const media =
                                            projeto.mediasCriterios
                                                ? projeto.mediasCriterios[
                                                    criterioId
                                                ]
                                                : null;


                                        const possuiMedia =
                                            media !== undefined &&
                                            media !== null &&
                                            media !== '' &&
                                            media !== '-' &&
                                            media !== 'N/A';
                                    %>


                                    <% if (!projetoUsaCriterio) { %>

                                        <!--
                                            PROTEÇÃO:
                                            este projeto não utiliza
                                            este critério.
                                        -->

                                        <td class="criterio-nao-utilizado">

                                            —

                                        </td>


                                    <% } else if (!possuiMedia) { %>


                                        <!--
                                            O projeto possui o critério,
                                            mas ainda não recebeu nota.
                                        -->

                                        <td class="criterio-sem-avaliacao">

                                            N/A

                                        </td>


                                    <% } else { %>


                                        <!-- NOTA -->

                                        <td class="nota-criterio">

                                            <%= media %>

                                        </td>


                                    <% } %>


                                <% }); %>


                                <!-- ============================= -->
                                <!-- MÉDIA GERAL                   -->
                                <!-- ============================= -->

                                <td class="col-media media-geral">

                                    <% if (
                                        projeto.mediaGeral !== undefined &&
                                        projeto.mediaGeral !== null &&
                                        projeto.mediaGeral !== '' &&
                                        projeto.mediaGeral !== '-'
                                    ) { %>

                                        <%= projeto.mediaGeral %>

                                    <% } else { %>

                                        -

                                    <% } %>

                                </td>


                            </tr>


                        <% }); %>


                    </tbody>

                </table>


                <div class="legenda">

                    — = critério não utilizado pelo projeto
                    &nbsp;&nbsp;|&nbsp;&nbsp;
                    N/A = critério ainda sem avaliação

                </div>


            </div>


        <% }); %>


    <% } else { %>


        <p class="no-data-message">

            Nenhum projeto avaliado para gerar
            o relatório consolidado.

        </p>


    <% } %>


</body>

</html>
