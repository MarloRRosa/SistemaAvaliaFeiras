<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= titulo %></title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  >

  <style>
    body {
      background: #f3f4f6;
    }

    .certificado-preview-wrapper {
      width: 100%;
      overflow-x: auto;
    }

    .certificado-preview {
      position: relative;
      margin: 0 auto;
      background-color: #ffffff;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      box-shadow: 0 10px 25px rgba(0,0,0,0.12);
      border: 1px solid #d1d5db;
      overflow: hidden;
    }

    .certificado-paisagem {
      width: 842px;
      height: 595px;
    }

    .certificado-retrato {
      width: 595px;
      height: 842px;
    }

    .preview-conteudo {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 50px;
      text-align: center;
    }

    .preview-titulo {
      font-size: 42px;
      font-weight: 700;
      color: #1f2937;
      margin-bottom: 35px;
    }

    .preview-texto {
      max-width: 680px;
      font-size: 22px;
      line-height: 1.6;
      color: #374151;
    }

    .preview-nome {
      display: block;
      font-size: 34px;
      font-weight: 700;
      margin: 20px 0;
      color: #111827;
    }
/* ===================================================== */
/* ELEMENTOS VISUAIS DO CERTIFICADO                      */
/* ===================================================== */

.elemento-certificado {
  position: absolute;
  z-index: 20;
  cursor: move;
  border: 1px dashed transparent;
  box-sizing: border-box;
  user-select: none;
  display: flex;
  align-items: center;
}

.elemento-certificado:hover {
  border-color: #8b5cf6;
}

.elemento-certificado.selecionado {
  border: 2px dashed #7c3aed;
  background-color: rgba(124, 58, 237, 0.04);
}

.elemento-texto-conteudo {
  width: 100%;
  white-space: pre-wrap;
  word-break: break-word;
}

/* O conteúdo de exemplo não deve impedir o arraste */
.preview-conteudo {
  pointer-events: none;
}

    @media (max-width: 1000px) {
      .certificado-preview {
        transform-origin: top left;
      }
    }
  </style>
</head>

<body>

  <div class="max-w-7xl mx-auto px-4 py-8">

    <!-- ================================================= -->
    <!-- CABEÇALHO                                         -->
    <!-- ================================================= -->

    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6 mb-6">

      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

        <div>

          <h1 class="text-3xl font-bold text-gray-800 flex items-center gap-3">

            <i class="fas fa-palette text-purple-600"></i>

            Editar Modelo de Certificado

          </h1>

          <p class="text-gray-600 mt-2">

            Modelo:

            <strong class="text-purple-700">
              <%= modelo.nome %>
            </strong>

          </p>

          <% if (feiraAtual) { %>

            <p class="text-sm text-gray-500 mt-1">

              Feira:
              <strong>
                <%= feiraAtual.nome %>
              </strong>

            </p>

          <% } %>

          <% if (escola && escola.nome) { %>

            <p class="text-sm text-gray-500">

              Escola:
              <%= escola.nome %>

            </p>

          <% } %>

        </div>


        <div class="flex flex-wrap gap-2">

          <a
            href="/admin/certificados/modelos<%= modelo.feira ? '?feiraId=' + modelo.feira : '' %>"
            class="inline-flex items-center bg-gray-600 hover:bg-gray-700 text-white font-semibold py-2 px-4 rounded-lg transition"
          >

            <i class="fas fa-arrow-left mr-2"></i>
            Voltar

          </a>

        </div>

      </div>

    </div>


    <!-- ================================================= -->
    <!-- MENSAGENS                                         -->
    <!-- ================================================= -->

    <% if (success_msg && success_msg.length > 0) { %>

      <div class="mb-6 bg-green-100 border border-green-300 text-green-800 px-4 py-3 rounded-lg">

        <i class="fas fa-check-circle mr-2"></i>

        <%= success_msg[0] %>

      </div>

    <% } %>


    <% if (error_msg && error_msg.length > 0) { %>

      <div class="mb-6 bg-red-100 border border-red-300 text-red-800 px-4 py-3 rounded-lg">

        <i class="fas fa-exclamation-circle mr-2"></i>

        <%= error_msg[0] %>

      </div>

    <% } %>


    <!-- ================================================= -->
    <!-- GRID PRINCIPAL                                    -->
    <!-- ================================================= -->

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">


      <!-- ================================================= -->
      <!-- PAINEL DE CONFIGURAÇÃO                            -->
      <!-- ================================================= -->

      <div class="xl:col-span-1">

        <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">

          <h2 class="text-xl font-bold text-gray-800 mb-5 flex items-center">

            <i class="fas fa-sliders-h text-purple-600 mr-2"></i>

            Configurações do Modelo

          </h2>


          <form
            action="/admin/certificados/modelos/<%= modelo._id %>/editar"
            method="POST"
            class="space-y-5"
          >


            <!-- NOME -->
            <div>

              <label
                for="nome"
                class="block text-sm font-semibold text-gray-700 mb-2"
              >
                Nome do modelo
              </label>

              <input
                type="text"
                id="nome"
                name="nome"
                value="<%= modelo.nome %>"
                required
                class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500"
              >

            </div>


            <!-- TIPO -->
            <div>

              <label
                for="tipo"
                class="block text-sm font-semibold text-gray-700 mb-2"
              >
                Tipo de certificado
              </label>

              <select
                id="tipo"
                name="tipo"
                required
                class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500"
              >

                <option
                  value="estudante"
                  <%= modelo.tipo === 'estudante' ? 'selected' : '' %>
                >
                  Estudante
                </option>

                <option
                  value="orientador"
                  <%= modelo.tipo === 'orientador' ? 'selected' : '' %>
                >
                  Orientador
                </option>

                <option
                  value="coorientador"
                  <%= modelo.tipo === 'coorientador' ? 'selected' : '' %>
                >
                  Coorientador
                </option>

                <option
                  value="avaliador"
                  <%= modelo.tipo === 'avaliador' ? 'selected' : '' %>
                >
                  Avaliador
                </option>

                <option
                  value="geral"
                  <%= modelo.tipo === 'geral' ? 'selected' : '' %>
                >
                  Geral
                </option>

              </select>

            </div>


            <!-- ORIENTAÇÃO -->
            <div>

              <label
                for="orientacao"
                class="block text-sm font-semibold text-gray-700 mb-2"
              >
                Orientação da página
              </label>

              <select
                id="orientacao"
                name="orientacao"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500"
              >

                <option
                  value="paisagem"
                  <%= modelo.orientacao === 'paisagem' ? 'selected' : '' %>
                >
                  Paisagem
                </option>

                <option
                  value="retrato"
                  <%= modelo.orientacao === 'retrato' ? 'selected' : '' %>
                >
                  Retrato
                </option>

              </select>

            </div>


            <!-- ATIVO -->
            <div class="flex items-center">

              <input
                type="checkbox"
                id="ativo"
                name="ativo"
                class="h-5 w-5 text-purple-600 border-gray-300 rounded"
                <%= modelo.ativo ? 'checked' : '' %>
              >

              <label
                for="ativo"
                class="ml-2 text-sm font-semibold text-gray-700"
              >
                Modelo ativo
              </label>

            </div>


            <!-- SALVAR -->
            <div class="pt-3">

              <button
                type="submit"
                class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2.5 px-5 rounded-lg shadow-md transition"
              >

                <i class="fas fa-save mr-2"></i>

                Salvar Configurações

              </button>

            </div>

          </form>

        </div>


        <!-- ================================================= -->
        <!-- ELEMENTOS DO CERTIFICADO                           -->
        <!-- ================================================= -->

        <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6 mt-6">

          <h2 class="text-xl font-bold text-gray-800 mb-4">

            <i class="fas fa-shapes text-blue-600 mr-2"></i>

            Elementos

          </h2>

          <p class="text-sm text-gray-500 mb-5">

            Em breve você poderá inserir e posicionar os elementos
            diretamente sobre o certificado.

          </p>


          <div class="grid grid-cols-2 gap-3">

<!-- ===================================================== -->
<!-- PROPRIEDADES DO TEXTO                                 -->
<!-- ===================================================== -->

<div
  id="painelTexto"
  class="bg-white rounded-xl shadow-md border border-purple-200 p-6 mt-6 hidden"
>

  <h2 class="text-xl font-bold text-gray-800 mb-4">

    <i class="fas fa-font text-purple-600 mr-2"></i>

    Editar Texto

  </h2>


  <input
    type="hidden"
    id="elementoTextoId"
  >


  <!-- TEXTO -->
  <div class="mb-4">

    <label
      for="elementoTextoConteudo"
      class="block text-sm font-semibold text-gray-700 mb-2"
    >
      Texto
    </label>

    <textarea
      id="elementoTextoConteudo"
      rows="4"
      class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500"
    ></textarea>

  </div>


  <!-- TAMANHO -->
  <div class="mb-4">

    <label
      for="elementoTamanhoFonte"
      class="block text-sm font-semibold text-gray-700 mb-2"
    >
      Tamanho da fonte
    </label>

    <input
      type="number"
      id="elementoTamanhoFonte"
      min="8"
      max="120"
      value="24"
      class="w-full border border-gray-300 rounded-lg px-3 py-2"
    >

  </div>


  <!-- COR -->
  <div class="mb-4">

    <label
      for="elementoCor"
      class="block text-sm font-semibold text-gray-700 mb-2"
    >
      Cor
    </label>

    <input
      type="color"
      id="elementoCor"
      value="#000000"
      class="w-full h-10 border border-gray-300 rounded-lg cursor-pointer"
    >

  </div>


  <!-- ESTILO -->
  <div class="flex gap-3 mb-4">

    <button
      type="button"
      id="btnTextoNegrito"
      class="flex-1 border border-gray-300 rounded-lg py-2 font-bold hover:bg-gray-100"
    >
      B
    </button>

    <button
      type="button"
      id="btnTextoItalico"
      class="flex-1 border border-gray-300 rounded-lg py-2 italic hover:bg-gray-100"
    >
      I
    </button>

  </div>


  <!-- ALINHAMENTO -->
  <div class="mb-5">

    <label
      for="elementoAlinhamento"
      class="block text-sm font-semibold text-gray-700 mb-2"
    >
      Alinhamento
    </label>

    <select
      id="elementoAlinhamento"
      class="w-full border border-gray-300 rounded-lg px-3 py-2"
    >
      <option value="left">Esquerda</option>
      <option value="center">Centralizado</option>
      <option value="right">Direita</option>
    </select>

  </div>


  <!-- EXCLUIR -->
  <button
    type="button"
    id="btnExcluirElemento"
    class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-2.5 px-4 rounded-lg transition"
  >

    <i class="fas fa-trash-alt mr-2"></i>

    Excluir Texto

  </button>

</div>


            <!-- TEXTO -->
<button
  type="button"
  id="btnAdicionarTexto"
  class="border border-blue-200 rounded-lg p-3 text-center bg-blue-50 text-blue-700 hover:bg-blue-100 hover:border-blue-300 transition"
>
  <i class="fas fa-font text-xl mb-2"></i>

  <div class="text-sm font-semibold">
    Texto
  </div>
</button>


<!-- PARTICIPANTE -->
<button
  type="button"
  disabled
  class="border border-gray-200 rounded-lg p-3 text-center bg-gray-100 text-gray-500 cursor-not-allowed"
>
  <i class="fas fa-user text-xl mb-2"></i>

  <div class="text-sm font-semibold">
    Participante
  </div>
</button>


<!-- LOGO -->
<button
  type="button"
  disabled
  class="border border-gray-200 rounded-lg p-3 text-center bg-gray-100 text-gray-500 cursor-not-allowed"
>
  <i class="fas fa-image text-xl mb-2"></i>

  <div class="text-sm font-semibold">
    Logo
  </div>
</button>


<!-- ASSINATURA -->
<button
  type="button"
  disabled
  class="border border-gray-200 rounded-lg p-3 text-center bg-gray-100 text-gray-500 cursor-not-allowed"
>
  <i class="fas fa-signature text-xl mb-2"></i>

  <div class="text-sm font-semibold">
    Assinatura
  </div>
</button>


            <!-- FUNDO -->
<button
  type="button"
  id="btnConfigurarFundo"
  class="border border-purple-200 rounded-lg p-3 text-center bg-purple-50 text-purple-700 hover:bg-purple-100 hover:border-purple-300 transition"
>
  <i class="fas fa-images text-xl mb-2"></i>

  <div class="text-sm font-semibold">
    Fundo
  </div>
</button>


            <!-- QR CODE -->
            <button
              type="button"
              disabled
              class="border border-gray-200 rounded-lg p-3 text-center bg-gray-100 text-gray-500 cursor-not-allowed"
            >

              <i class="fas fa-qrcode text-xl mb-2"></i>

              <div class="text-sm font-semibold">
                QR Code
              </div>

            </button>

          </div>

        </div>

      </div>


      <!-- ================================================= -->
      <!-- PRÉ-VISUALIZAÇÃO                                  -->
      <!-- ================================================= -->

      <div class="xl:col-span-2">

        <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">

          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-5">

            <div>

              <h2 class="text-xl font-bold text-gray-800">

                <i class="fas fa-eye text-blue-600 mr-2"></i>

                Pré-visualização

              </h2>

              <p class="text-sm text-gray-500 mt-1">
                Exemplo aproximado de como o certificado ficará.
              </p>

            </div>


            <span class="text-xs font-semibold bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full">

              Editor visual em desenvolvimento

            </span>

          </div>


          <div class="certificado-preview-wrapper">

            <%
  let backgroundSize = 'cover';

  if (modelo.ajusteFundo === 'conter') {
    backgroundSize = 'contain';
  } else if (modelo.ajusteFundo === 'esticar') {
    backgroundSize = '100% 100%';
  }
%>

<div
  id="certificadoPreview"
  class="certificado-preview <%= modelo.orientacao === 'retrato' ? 'certificado-retrato' : 'certificado-paisagem' %>"
  style="
    <% if (modelo.fundoUrl) { %>
      background-image: url('<%= modelo.fundoUrl %>');
    <% } %>
    background-size: <%= backgroundSize %>;
    background-position: center;
    background-repeat: no-repeat;
  "
>
<!-- ===================================================== -->
<!-- ELEMENTOS DE TEXTO JÁ SALVOS                          -->
<!-- ===================================================== -->

<%
  const elementosTexto =
    Array.isArray(modelo.elementos)
      ? modelo.elementos.filter(el => el.tipo === 'texto')
      : [];
%>

<% elementosTexto.forEach(elemento => { %>

  <div
    class="elemento-certificado elemento-texto"
    data-elemento-id="<%= elemento._id %>"
    data-tipo="texto"
    data-texto="<%= elemento.texto || '' %>"

    style="
      left: <%= elemento.x || 0 %>px;
      top: <%= elemento.y || 0 %>px;
      width: <%= elemento.largura || 300 %>px;
      height: <%= elemento.altura || 50 %>px;

      font-family: <%= elemento.fonte || 'Arial' %>;
      font-size: <%= elemento.tamanhoFonte || 24 %>px;

      font-weight:
        <%= elemento.negrito ? 'bold' : 'normal' %>;

      font-style:
        <%= elemento.italico ? 'italic' : 'normal' %>;

      color:
        <%= elemento.cor || '#000000' %>;

      text-align:
        <%= elemento.alinhamento || 'center' %>;
    "
  >

    <div class="elemento-texto-conteudo">
      <%= elemento.texto || 'Digite seu texto' %>
    </div>

  </div>

<% }) %>

              <div class="preview-conteudo">

                <% if (escola && escola.logo) { %>

                  <img
                    src="<%= escola.logo %>"
                    alt="Logo da escola"
                    style="max-height: 90px; max-width: 180px; margin-bottom: 25px;"
                  >

                <% } %>


                <div class="preview-titulo">

                  CERTIFICADO

                </div>


                <div class="preview-texto">

                  Certificamos que

                  <span class="preview-nome">

                    NOME DO PARTICIPANTE

                  </span>

                  participou da

                  <strong>

                    <%= feiraAtual ? feiraAtual.nome : 'Feira de Ciências' %>

                  </strong>.

                </div>


                <% if (escola && escola.nome) { %>

                  <div class="mt-10 text-lg text-gray-600">

                    <%= escola.nome %>

                  </div>

                <% } %>

              </div>

            </div>

          </div>


          <!-- LEGENDA -->
          <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">

            <div class="flex items-start">

              <i class="fas fa-info-circle text-blue-500 mt-1 mr-3"></i>

              <div>

                <p class="font-semibold text-blue-800">

                  Próxima etapa

                </p>

                <p class="text-sm text-blue-700 mt-1">

                  Nesta área será possível clicar em elementos como
                  nome do participante, textos, logos e assinaturas,
                  posicioná-los livremente no certificado e alterar
                  fonte, tamanho, cor e alinhamento.

                </p>

              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

<!-- ===================================================== -->
<!-- MODAL: FUNDO DO CERTIFICADO                           -->
<!-- ===================================================== -->

<div
  id="modalFundoCertificado"
  class="fixed inset-0 bg-black bg-opacity-60 hidden items-center justify-center z-50 p-4"
>

  <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg relative">

    <!-- CABEÇALHO -->
    <div class="flex items-center justify-between p-5 border-b border-gray-200">

      <div>
        <h2 class="text-xl font-bold text-gray-800">
          <i class="fas fa-images text-purple-600 mr-2"></i>
          Fundo do Certificado
        </h2>

        <p class="text-sm text-gray-500 mt-1">
          Escolha uma imagem para preencher o fundo da página.
        </p>
      </div>

      <button
        type="button"
        id="btnFecharModalFundo"
        class="text-gray-400 hover:text-gray-700 text-3xl leading-none"
      >
        &times;
      </button>

    </div>


    <!-- FORMULÁRIO -->
    <form
      action="/admin/certificados/modelos/<%= modelo._id %>/fundo"
      method="POST"
      enctype="multipart/form-data"
      class="p-5"
    >

      <!-- FUNDO ATUAL -->
      <% if (modelo.fundoUrl) { %>

        <div class="mb-5">

          <label class="block text-sm font-semibold text-gray-700 mb-2">
            Fundo atual
          </label>

          <div class="border border-gray-200 rounded-lg overflow-hidden bg-gray-100">

            <img
              src="<%= modelo.fundoUrl %>"
              alt="Fundo atual do certificado"
              class="w-full h-40 object-contain"
            >

          </div>

        </div>

      <% } %>


      <!-- ESCOLHER IMAGEM -->
      <div class="mb-5">

        <label
          for="fundoCertificado"
          class="block text-sm font-semibold text-gray-700 mb-2"
        >
          Escolher imagem
        </label>

        <input
          type="file"
          id="fundoCertificado"
          name="fundoCertificado"
          accept="image/png,image/jpeg,image/webp"
          class="block w-full text-sm text-gray-700 border border-gray-300 rounded-lg p-2"
          required
        >

        <p class="text-xs text-gray-500 mt-2">
          Formatos recomendados: JPG, PNG ou WEBP.
          Para A4 paisagem, prefira imagens horizontais em alta resolução.
        </p>

      </div>


      <!-- PRÉVIA LOCAL -->
      <div
        id="previewNovoFundoContainer"
        class="mb-5 hidden"
      >

        <label class="block text-sm font-semibold text-gray-700 mb-2">
          Nova imagem
        </label>

        <div class="border border-gray-200 rounded-lg overflow-hidden bg-gray-100">

          <img
            id="previewNovoFundo"
            src=""
            alt="Prévia do novo fundo"
            class="w-full h-40 object-contain"
          >

        </div>

      </div>


      <!-- AJUSTE -->
      <div class="mb-6">

        <label
          for="ajusteFundo"
          class="block text-sm font-semibold text-gray-700 mb-2"
        >
          Como a imagem deve ocupar o certificado?
        </label>

        <select
          id="ajusteFundo"
          name="ajusteFundo"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500"
        >

          <option
            value="cobrir"
            <%= (!modelo.ajusteFundo || modelo.ajusteFundo === 'cobrir') ? 'selected' : '' %>
          >
            Preencher toda a página
          </option>

          <option
            value="conter"
            <%= modelo.ajusteFundo === 'conter' ? 'selected' : '' %>
          >
            Mostrar imagem completa
          </option>

          <option
            value="esticar"
            <%= modelo.ajusteFundo === 'esticar' ? 'selected' : '' %>
          >
            Esticar para preencher
          </option>

        </select>

        <div class="mt-3 bg-blue-50 border border-blue-100 rounded-lg p-3 text-xs text-blue-700">

          <strong>Preencher:</strong>
          ocupa toda a folha e pode cortar pequenas partes da imagem.

          <br>

          <strong>Imagem completa:</strong>
          mantém toda a imagem visível, podendo deixar espaços.

          <br>

          <strong>Esticar:</strong>
          força a imagem a ocupar toda a página.

        </div>

      </div>


      <!-- BOTÕES -->
      <div class="flex justify-end gap-3">

        <button
          type="button"
          id="btnCancelarFundo"
          class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2.5 px-4 rounded-lg transition"
        >
          Cancelar
        </button>

        <button
          type="submit"
          class="bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2.5 px-5 rounded-lg shadow-md transition"
        >
          <i class="fas fa-save mr-2"></i>
          Salvar Fundo
        </button>

      </div>

    </form>

  </div>

</div>

  <script>
document.addEventListener('DOMContentLoaded', function () {

  // =====================================================
  // ELEMENTOS
  // =====================================================

  const orientacao =
    document.getElementById('orientacao');

  const certificadoPreview =
    document.getElementById('certificadoPreview');


  const btnConfigurarFundo =
    document.getElementById('btnConfigurarFundo');

  const modalFundoCertificado =
    document.getElementById('modalFundoCertificado');

  const btnFecharModalFundo =
    document.getElementById('btnFecharModalFundo');

  const btnCancelarFundo =
    document.getElementById('btnCancelarFundo');

  const inputFundo =
    document.getElementById('fundoCertificado');

  const ajusteFundo =
    document.getElementById('ajusteFundo');

  const previewNovoFundo =
    document.getElementById('previewNovoFundo');

  const previewNovoFundoContainer =
    document.getElementById('previewNovoFundoContainer');


  // =====================================================
  // ORIENTAÇÃO DA PÁGINA
  // =====================================================

  if (
    orientacao &&
    certificadoPreview
  ) {

    orientacao.addEventListener(
      'change',
      function () {

        certificadoPreview.classList.remove(
          'certificado-paisagem',
          'certificado-retrato'
        );

        if (this.value === 'retrato') {

          certificadoPreview.classList.add(
            'certificado-retrato'
          );

        } else {

          certificadoPreview.classList.add(
            'certificado-paisagem'
          );

        }
      }
    );
  }


  // =====================================================
  // ABRIR MODAL DE FUNDO
  // =====================================================

  function abrirModalFundo() {

    if (!modalFundoCertificado) {
      return;
    }

    modalFundoCertificado.classList.remove(
      'hidden'
    );

    modalFundoCertificado.classList.add(
      'flex'
    );
  }


  // =====================================================
  // FECHAR MODAL DE FUNDO
  // =====================================================

  function fecharModalFundo() {

    if (!modalFundoCertificado) {
      return;
    }

    modalFundoCertificado.classList.remove(
      'flex'
    );

    modalFundoCertificado.classList.add(
      'hidden'
    );
  }


  if (btnConfigurarFundo) {

    btnConfigurarFundo.addEventListener(
      'click',
      abrirModalFundo
    );
  }


  if (btnFecharModalFundo) {

    btnFecharModalFundo.addEventListener(
      'click',
      fecharModalFundo
    );
  }


  if (btnCancelarFundo) {

    btnCancelarFundo.addEventListener(
      'click',
      fecharModalFundo
    );
  }


  // =====================================================
  // FECHAR CLICANDO FORA
  // =====================================================

  if (modalFundoCertificado) {

    modalFundoCertificado.addEventListener(
      'click',
      function (event) {

        if (
          event.target ===
          modalFundoCertificado
        ) {

          fecharModalFundo();
        }
      }
    );
  }


  // =====================================================
  // FUNÇÃO DE AJUSTE DO FUNDO
  // =====================================================

  function aplicarAjusteFundo(valor) {

    if (!certificadoPreview) {
      return;
    }


    if (valor === 'conter') {

      certificadoPreview.style.backgroundSize =
        'contain';

    } else if (valor === 'esticar') {

      certificadoPreview.style.backgroundSize =
        '100% 100%';

    } else {

      certificadoPreview.style.backgroundSize =
        'cover';
    }


    certificadoPreview.style.backgroundPosition =
      'center';

    certificadoPreview.style.backgroundRepeat =
      'no-repeat';
  }


  // =====================================================
  // ALTERAR AJUSTE EM TEMPO REAL
  // =====================================================

  if (ajusteFundo) {

    ajusteFundo.addEventListener(
      'change',
      function () {

        aplicarAjusteFundo(
          this.value
        );
      }
    );
  }


  // =====================================================
  // PRÉ-VISUALIZAÇÃO IMEDIATA DA IMAGEM
  // =====================================================

  if (inputFundo) {

    inputFundo.addEventListener(
      'change',
      function () {

        const arquivo =
          this.files &&
          this.files[0];


        if (!arquivo) {

          if (
            previewNovoFundoContainer
          ) {

            previewNovoFundoContainer
              .classList
              .add('hidden');
          }

          return;
        }


        // Validação básica
        if (
          !arquivo.type.startsWith('image/')
        ) {

          alert(
            'Selecione um arquivo de imagem válido.'
          );

          this.value = '';

          return;
        }


        const reader =
          new FileReader();


        reader.onload =
          function (event) {

            const imagemUrl =
              event.target.result;


            // Mostrar pequena prévia no modal
            if (
              previewNovoFundo &&
              previewNovoFundoContainer
            ) {

              previewNovoFundo.src =
                imagemUrl;

              previewNovoFundoContainer
                .classList
                .remove('hidden');
            }


            // Mostrar imediatamente no certificado
            if (certificadoPreview) {

              certificadoPreview.style.backgroundImage =
                `url("${imagemUrl}")`;


              aplicarAjusteFundo(
                ajusteFundo
                  ? ajusteFundo.value
                  : 'cobrir'
              );
            }
          };


        reader.readAsDataURL(
          arquivo
        );
      }
    );
  }

// =====================================================
// EDITOR - ELEMENTOS DE TEXTO
// =====================================================

const modeloCertificadoId =
  '<%= modelo._id %>';

const btnAdicionarTexto =
  document.getElementById('btnAdicionarTexto');

const painelTexto =
  document.getElementById('painelTexto');

const elementoTextoId =
  document.getElementById('elementoTextoId');

const elementoTextoConteudo =
  document.getElementById('elementoTextoConteudo');

const elementoTamanhoFonte =
  document.getElementById('elementoTamanhoFonte');

const elementoCor =
  document.getElementById('elementoCor');

const elementoAlinhamento =
  document.getElementById('elementoAlinhamento');

const btnTextoNegrito =
  document.getElementById('btnTextoNegrito');

const btnTextoItalico =
  document.getElementById('btnTextoItalico');

const btnExcluirElemento =
  document.getElementById('btnExcluirElemento');


let elementoSelecionado = null;

let textoNegrito = false;
let textoItalico = false;


// =====================================================
// REQUISIÇÃO PARA ATUALIZAR ELEMENTO
// =====================================================

async function atualizarElemento(
  elementoId,
  dados
) {

  const body =
    new URLSearchParams();

  Object.entries(dados)
    .forEach(([chave, valor]) => {

      body.append(
        chave,
        valor
      );
    });


  const resposta =
    await fetch(
      `/admin/certificados/modelos/${modeloCertificadoId}/elementos/${elementoId}`,
      {
        method: 'POST',

        headers: {
          'Content-Type':
            'application/x-www-form-urlencoded;charset=UTF-8'
        },

        body
      }
    );


  const resultado =
    await resposta.json();


  if (!resultado.sucesso) {

    throw new Error(
      resultado.mensagem ||
      'Não foi possível salvar o elemento.'
    );
  }


  return resultado;
}


// =====================================================
// CRIAR ELEMENTO NO HTML
// =====================================================

function criarElementoTextoVisual(elemento) {

  const div =
    document.createElement('div');


  div.className =
    'elemento-certificado elemento-texto';


  div.dataset.elementoId =
    elemento._id;


  div.dataset.tipo =
    'texto';


  div.style.left =
    `${elemento.x || 0}px`;

  div.style.top =
    `${elemento.y || 0}px`;

  div.style.width =
    `${elemento.largura || 340}px`;

  div.style.height =
    `${elemento.altura || 50}px`;

  div.style.fontFamily =
    elemento.fonte || 'Arial';

  div.style.fontSize =
    `${elemento.tamanhoFonte || 24}px`;

  div.style.fontWeight =
    elemento.negrito
      ? 'bold'
      : 'normal';

  div.style.fontStyle =
    elemento.italico
      ? 'italic'
      : 'normal';

  div.style.color =
    elemento.cor || '#000000';

  div.style.textAlign =
    elemento.alinhamento || 'center';


  const conteudo =
    document.createElement('div');


  conteudo.className =
    'elemento-texto-conteudo';


  conteudo.textContent =
    elemento.texto ||
    'Digite seu texto';


  div.appendChild(
    conteudo
  );


  certificadoPreview.appendChild(
    div
  );


  prepararElementoTexto(
    div
  );


  selecionarElementoTexto(
    div
  );
}


// =====================================================
// ADICIONAR TEXTO
// =====================================================

if (btnAdicionarTexto) {

  btnAdicionarTexto.addEventListener(
    'click',
    async function () {

      try {

        btnAdicionarTexto.disabled =
          true;


        const resposta =
          await fetch(
            `/admin/certificados/modelos/${modeloCertificadoId}/elementos/texto`,
            {
              method:
                'POST'
            }
          );


        const resultado =
          await resposta.json();


        if (!resultado.sucesso) {

          throw new Error(
            resultado.mensagem ||
            'Não foi possível adicionar o texto.'
          );
        }


        criarElementoTextoVisual(
          resultado.elemento
        );


      } catch (erro) {

        console.error(
          erro
        );

        alert(
          erro.message
        );

      } finally {

        btnAdicionarTexto.disabled =
          false;
      }
    }
  );
}


// =====================================================
// SELECIONAR ELEMENTO
// =====================================================

function selecionarElementoTexto(elemento) {

  document
    .querySelectorAll(
      '.elemento-certificado'
    )
    .forEach(el => {

      el.classList.remove(
        'selecionado'
      );
    });


  elemento.classList.add(
    'selecionado'
  );


  elementoSelecionado =
    elemento;


  const conteudo =
    elemento.querySelector(
      '.elemento-texto-conteudo'
    );


  elementoTextoId.value =
    elemento.dataset.elementoId;


  elementoTextoConteudo.value =
    conteudo
      ? conteudo.textContent
      : '';


  elementoTamanhoFonte.value =
    parseInt(
      elemento.style.fontSize,
      10
    ) || 24;


  elementoCor.value =
    rgbParaHex(
      elemento.style.color
    );


  elementoAlinhamento.value =
    elemento.style.textAlign ||
    'center';


  textoNegrito =
    elemento.style.fontWeight ===
      'bold' ||
    Number(
      elemento.style.fontWeight
    ) >= 600;


  textoItalico =
    elemento.style.fontStyle ===
    'italic';


  atualizarEstadoBotoesTexto();


  painelTexto.classList.remove(
    'hidden'
  );
}


// =====================================================
// PREPARAR ELEMENTO EXISTENTE
// =====================================================

function prepararElementoTexto(elemento) {

  elemento.addEventListener(
    'click',
    function (event) {

      event.stopPropagation();

      selecionarElementoTexto(
        elemento
      );
    }
  );


  ativarArraste(
    elemento
  );
}


// Elementos que vieram do MongoDB
document
  .querySelectorAll(
    '.elemento-texto'
  )
  .forEach(
    prepararElementoTexto
  );


// =====================================================
// ARRASTAR ELEMENTO
// =====================================================

function ativarArraste(elemento) {

  elemento.addEventListener(
    'pointerdown',
    function (event) {

      if (
        event.button !== undefined &&
        event.button !== 0
      ) {
        return;
      }


      event.preventDefault();

      event.stopPropagation();


      selecionarElementoTexto(
        elemento
      );


      elemento.setPointerCapture(
        event.pointerId
      );


      const previewRect =
        certificadoPreview
          .getBoundingClientRect();


      const elementoRect =
        elemento
          .getBoundingClientRect();


      const offsetX =
        event.clientX -
        elementoRect.left;


      const offsetY =
        event.clientY -
        elementoRect.top;


      function mover(eventMove) {

        let novoX =
          eventMove.clientX -
          previewRect.left -
          offsetX;


        let novoY =
          eventMove.clientY -
          previewRect.top -
          offsetY;


        // Limites da folha
        novoX =
          Math.max(
            0,
            Math.min(
              novoX,
              certificadoPreview.clientWidth -
              elemento.offsetWidth
            )
          );


        novoY =
          Math.max(
            0,
            Math.min(
              novoY,
              certificadoPreview.clientHeight -
              elemento.offsetHeight
            )
          );


        elemento.style.left =
          `${Math.round(novoX)}px`;


        elemento.style.top =
          `${Math.round(novoY)}px`;
      }


      async function finalizar() {

        elemento.removeEventListener(
          'pointermove',
          mover
        );


        elemento.removeEventListener(
          'pointerup',
          finalizar
        );


        elemento.removeEventListener(
          'pointercancel',
          finalizar
        );


        try {

          await atualizarElemento(
            elemento.dataset.elementoId,
            {
              x:
                parseInt(
                  elemento.style.left,
                  10
                ) || 0,

              y:
                parseInt(
                  elemento.style.top,
                  10
                ) || 0
            }
          );

        } catch (erro) {

          console.error(
            'Erro ao salvar posição:',
            erro
          );
        }
      }


      elemento.addEventListener(
        'pointermove',
        mover
      );


      elemento.addEventListener(
        'pointerup',
        finalizar
      );


      elemento.addEventListener(
        'pointercancel',
        finalizar
      );
    }
  );
}


// =====================================================
// CONTEÚDO DO TEXTO
// =====================================================

let timerTexto = null;


if (elementoTextoConteudo) {

  elementoTextoConteudo.addEventListener(
    'input',
    function () {

      if (!elementoSelecionado) {
        return;
      }


      const conteudo =
        elementoSelecionado
          .querySelector(
            '.elemento-texto-conteudo'
          );


      if (conteudo) {

        conteudo.textContent =
          this.value;
      }


      clearTimeout(
        timerTexto
      );


      timerTexto =
        setTimeout(
          async () => {

            try {

              await atualizarElemento(
                elementoSelecionado
                  .dataset
                  .elementoId,
                {
                  texto:
                    elementoTextoConteudo
                      .value
                }
              );

            } catch (erro) {

              console.error(
                erro
              );
            }
          },
          500
        );
    }
  );
}


// =====================================================
// TAMANHO DA FONTE
// =====================================================

if (elementoTamanhoFonte) {

  elementoTamanhoFonte.addEventListener(
    'change',
    async function () {

      if (!elementoSelecionado) {
        return;
      }


      const tamanho =
        Number(
          this.value
        );


      elementoSelecionado.style.fontSize =
        `${tamanho}px`;


      await atualizarElemento(
        elementoSelecionado
          .dataset
          .elementoId,
        {
          tamanhoFonte:
            tamanho
        }
      );
    }
  );
}


// =====================================================
// COR
// =====================================================

if (elementoCor) {

  elementoCor.addEventListener(
    'input',
    async function () {

      if (!elementoSelecionado) {
        return;
      }


      elementoSelecionado.style.color =
        this.value;


      await atualizarElemento(
        elementoSelecionado
          .dataset
          .elementoId,
        {
          cor:
            this.value
        }
      );
    }
  );
}


// =====================================================
// ALINHAMENTO
// =====================================================

if (elementoAlinhamento) {

  elementoAlinhamento.addEventListener(
    'change',
    async function () {

      if (!elementoSelecionado) {
        return;
      }


      elementoSelecionado.style.textAlign =
        this.value;


      await atualizarElemento(
        elementoSelecionado
          .dataset
          .elementoId,
        {
          alinhamento:
            this.value
        }
      );
    }
  );
}


// =====================================================
// NEGRITO
// =====================================================

if (btnTextoNegrito) {

  btnTextoNegrito.addEventListener(
    'click',
    async function () {

      if (!elementoSelecionado) {
        return;
      }


      textoNegrito =
        !textoNegrito;


      elementoSelecionado.style.fontWeight =
        textoNegrito
          ? 'bold'
          : 'normal';


      atualizarEstadoBotoesTexto();


      await atualizarElemento(
        elementoSelecionado
          .dataset
          .elementoId,
        {
          negrito:
            textoNegrito
        }
      );
    }
  );
}


// =====================================================
// ITÁLICO
// =====================================================

if (btnTextoItalico) {

  btnTextoItalico.addEventListener(
    'click',
    async function () {

      if (!elementoSelecionado) {
        return;
      }


      textoItalico =
        !textoItalico;


      elementoSelecionado.style.fontStyle =
        textoItalico
          ? 'italic'
          : 'normal';


      atualizarEstadoBotoesTexto();


      await atualizarElemento(
        elementoSelecionado
          .dataset
          .elementoId,
        {
          italico:
            textoItalico
        }
      );
    }
  );
}


function atualizarEstadoBotoesTexto() {

  if (btnTextoNegrito) {

    btnTextoNegrito.classList.toggle(
      'bg-purple-100',
      textoNegrito
    );

    btnTextoNegrito.classList.toggle(
      'border-purple-500',
      textoNegrito
    );
  }


  if (btnTextoItalico) {

    btnTextoItalico.classList.toggle(
      'bg-purple-100',
      textoItalico
    );

    btnTextoItalico.classList.toggle(
      'border-purple-500',
      textoItalico
    );
  }
}


// =====================================================
// EXCLUIR ELEMENTO
// =====================================================

if (btnExcluirElemento) {

  btnExcluirElemento.addEventListener(
    'click',
    async function () {

      if (!elementoSelecionado) {
        return;
      }


      if (
        !confirm(
          'Deseja excluir este texto do certificado?'
        )
      ) {

        return;
      }


      try {

        const resposta =
          await fetch(
            `/admin/certificados/modelos/${modeloCertificadoId}/elementos/${elementoSelecionado.dataset.elementoId}/excluir`,
            {
              method:
                'POST'
            }
          );


        const resultado =
          await resposta.json();


        if (!resultado.sucesso) {

          throw new Error(
            resultado.mensagem ||
            'Não foi possível excluir.'
          );
        }


        elementoSelecionado.remove();

        elementoSelecionado =
          null;


        painelTexto.classList.add(
          'hidden'
        );


      } catch (erro) {

        console.error(
          erro
        );

        alert(
          erro.message
        );
      }
    }
  );
}


// =====================================================
// CONVERTER RGB PARA HEX
// =====================================================

function rgbParaHex(cor) {

  if (
    !cor ||
    cor.startsWith('#')
  ) {

    return cor || '#000000';
  }


  const numeros =
    cor.match(/\d+/g);


  if (
    !numeros ||
    numeros.length < 3
  ) {

    return '#000000';
  }


  return (
    '#' +
    numeros
      .slice(0, 3)
      .map(numero =>
        Number(numero)
          .toString(16)
          .padStart(2, '0')
      )
      .join('')
  );
}


// Clicar na folha sem selecionar elemento
if (certificadoPreview) {

  certificadoPreview.addEventListener(
    'click',
    function (event) {

      if (
        event.target !==
        certificadoPreview
      ) {
        return;
      }


      document
        .querySelectorAll(
          '.elemento-certificado'
        )
        .forEach(el =>
          el.classList.remove(
            'selecionado'
          )
        );


      elementoSelecionado =
        null;


      painelTexto.classList.add(
        'hidden'
      );
    }
  );
}

});
</script>

</body>
</html>
