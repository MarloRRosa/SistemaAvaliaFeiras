<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %></title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  >
</head>

<body class="bg-gray-100 min-h-screen text-gray-800">

  <div class="max-w-6xl mx-auto px-4 py-8">

    <!-- CABEÇALHO -->
    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6 mb-6">

      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

        <div>
          <h1 class="text-3xl font-bold text-gray-800 flex items-center gap-3">
            <i class="fas fa-certificate text-purple-600"></i>
            Modelos de Certificado
          </h1>

          <p class="text-gray-600 mt-2">
            Feira:
            <strong class="text-blue-700">
              <%= feiraAtual ? feiraAtual.nome : 'Não identificada' %>
            </strong>
          </p>

          <% if (escola && escola.nome) { %>
            <p class="text-sm text-gray-500 mt-1">
              Escola: <%= escola.nome %>
            </p>
          <% } %>
        </div>

        <div>
          <a
            href="/admin/dashboard?tab=certificados"
            class="inline-flex items-center bg-gray-600 hover:bg-gray-700 text-white font-semibold py-2 px-4 rounded-lg transition"
          >
            <i class="fas fa-arrow-left mr-2"></i>
            Voltar
          </a>
        </div>

      </div>

    </div>


    <!-- MENSAGENS -->
    <% if (success_msg && success_msg.length > 0) { %>
      <div class="mb-6 bg-green-100 border border-green-300 text-green-800 px-4 py-3 rounded-lg">
        <i class="fas fa-check-circle mr-2"></i>
        <%= success_msg[0] %>
      </div>
    <% } %>

    <% if (error_msg && error_msg.length > 0) { %>
      <div class="mb-6 bg-red-100 border border-red-300 text-red-800 px-4 py-3 rounded-lg">
        <i class="fas fa-exclamation-circle mr-2"></i>
        <%= error_msg[0] %>
      </div>
    <% } %>


    <!-- NOVO MODELO -->
    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6 mb-8">

      <h2 class="text-xl font-bold text-gray-800 mb-5 flex items-center">
        <i class="fas fa-plus-circle text-purple-600 mr-2"></i>
        Criar Novo Modelo
      </h2>

      <form
        action="/admin/certificados/modelos"
        method="POST"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4"
      >

        <input
          type="hidden"
          name="feiraId"
          value="<%= feiraAtual ? feiraAtual._id : '' %>"
        >


        <!-- NOME -->
        <div class="lg:col-span-2">

          <label
            for="nome"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Nome do modelo
          </label>

          <input
            type="text"
            id="nome"
            name="nome"
            required
            placeholder="Ex.: Certificado Estudantes FEMINT 2026"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500"
          >

        </div>


        <!-- TIPO -->
        <div>

          <label
            for="tipo"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Tipo
          </label>

          <select
            id="tipo"
            name="tipo"
            required
            class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500"
          >
            <option value="">Selecione</option>
            <option value="estudante">Estudante</option>
            <option value="orientador">Orientador</option>
            <option value="coorientador">Coorientador</option>
            <option value="avaliador">Avaliador</option>
            <option value="geral">Geral</option>
          </select>

        </div>


        <!-- ORIENTAÇÃO -->
        <div>

          <label
            for="orientacao"
            class="block text-sm font-semibold text-gray-700 mb-2"
          >
            Orientação
          </label>

          <select
            id="orientacao"
            name="orientacao"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500"
          >
            <option value="paisagem">Paisagem</option>
            <option value="retrato">Retrato</option>
          </select>

        </div>


        <!-- BOTÃO -->
        <div class="lg:col-span-4 flex justify-end mt-2">

          <button
            type="submit"
            class="bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2.5 px-5 rounded-lg shadow-md transition"
          >
            <i class="fas fa-save mr-2"></i>
            Criar Modelo
          </button>

        </div>

      </form>

    </div>


    <!-- LISTAGEM -->
    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">

      <div class="flex items-center justify-between mb-5">

        <h2 class="text-xl font-bold text-gray-800 flex items-center">
          <i class="fas fa-list text-blue-600 mr-2"></i>
          Modelos Cadastrados
        </h2>

        <span class="text-sm text-gray-500">
          Total: <strong><%= modelos ? modelos.length : 0 %></strong>
        </span>

      </div>


      <% if (modelos && modelos.length > 0) { %>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

          <% modelos.forEach(modelo => { %>

            <div class="border border-gray-200 rounded-xl p-5 hover:shadow-md transition bg-gray-50">

              <div class="flex items-start justify-between gap-3 mb-3">

                <div>

                  <h3 class="text-lg font-bold text-gray-800">
                    <%= modelo.nome %>
                  </h3>

                  <p class="text-sm text-gray-500 mt-1">
                    Criado em:
                    <%= modelo.createdAt
                      ? new Date(modelo.createdAt).toLocaleDateString('pt-BR')
                      : '-'
                    %>
                  </p>

                </div>


                <% if (modelo.ativo) { %>

                  <span class="text-xs font-semibold bg-green-100 text-green-700 px-2 py-1 rounded-full">
                    Ativo
                  </span>

                <% } else { %>

                  <span class="text-xs font-semibold bg-gray-200 text-gray-600 px-2 py-1 rounded-full">
                    Inativo
                  </span>

                <% } %>

              </div>


              <div class="space-y-2 text-sm text-gray-700 mb-5">

                <p>
                  <strong>Tipo:</strong>

                  <% if (modelo.tipo === 'estudante') { %>
                    Estudante
                  <% } else if (modelo.tipo === 'orientador') { %>
                    Orientador
                  <% } else if (modelo.tipo === 'coorientador') { %>
                    Coorientador
                  <% } else if (modelo.tipo === 'avaliador') { %>
                    Avaliador
                  <% } else { %>
                    Geral
                  <% } %>

                </p>

                <p>
                  <strong>Orientação:</strong>
                  <%= modelo.orientacao === 'retrato' ? 'Retrato' : 'Paisagem' %>
                </p>

                <p>
                  <strong>Elementos:</strong>
                  <%= Array.isArray(modelo.elementos) ? modelo.elementos.length : 0 %>
                </p>

              </div>


              <div class="flex flex-wrap gap-2">

                <!-- EDITAR -->
                <a
  href="/admin/certificados/modelos/<%= modelo._id %>/editar"
  class="flex-1 text-center bg-yellow-500 hover:bg-yellow-600 text-white font-semibold py-2 px-3 rounded-lg transition"
>
  <i class="fas fa-edit mr-1"></i>
  Editar
</a>

                <!-- PREVIEW -->
                <button
                  type="button"
                  disabled
                  title="Pré-visualização será implementada posteriormente"
                  class="flex-1 bg-gray-300 text-gray-600 font-semibold py-2 px-3 rounded-lg cursor-not-allowed"
                >
                  <i class="fas fa-eye mr-1"></i>
                  Visualizar
                </button>


                <!-- EXCLUIR -->
                <form
                  method="POST"
                  action="/admin/certificados/modelos/<%= modelo._id %>/excluir"
                  class="w-full"
                  onsubmit="return confirm('Tem certeza que deseja excluir este modelo de certificado?');"
                >

                  <button
                    type="submit"
                    class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-3 rounded-lg transition"
                  >
                    <i class="fas fa-trash-alt mr-1"></i>
                    Excluir Modelo
                  </button>

                </form>

              </div>

            </div>

          <% }) %>

        </div>

      <% } else { %>

        <div class="text-center py-12">

          <i class="fas fa-certificate text-gray-300 text-6xl mb-4"></i>

          <h3 class="text-lg font-semibold text-gray-600">
            Nenhum modelo cadastrado
          </h3>

          <p class="text-sm text-gray-500 mt-2">
            Crie seu primeiro modelo usando o formulário acima.
          </p>

        </div>

      <% } %>

    </div>

  </div>

</body>
</html>
