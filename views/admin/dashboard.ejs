                                    <button
                                        type="button"
                                        class="tooltip btn-reenviar-avaliador btn-hover-effect text-white shadow-sm"
                                        data-tooltip="Reenviar"
                                        data-id="<%= avaliador._id %>"
                                        data-nome="<%= avaliador.nome %>"
