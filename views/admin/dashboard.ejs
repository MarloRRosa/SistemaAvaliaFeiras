                    aria-label="Selecionar todos os avaliadores"
                >
                <label
                    for="selecionarTodosAvaliadores"
                    class="text-sm font-medium text-gray-700 cursor-pointer"
                >
                    Selecionar Todos
                </label>
            </div>

            <button
                id="btnReenviarSelecionados"
                class="bg-green-600 hover:bg-green-700 text-white font-semibold py-1.5 px-3 rounded-md text-sm shadow-sm flex items-center"
            >
