<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= titulo %>
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    >

    <style>
        body {
            background:
                linear-gradient(
                    135deg,
                    #f1f5f9 0%,
                    #e2e8f0 100%
                );
        }

        .tabela-avaliacoes th,
        .tabela-avaliacoes td {
            vertical-align: middle;
        }

        details > summary {
            list-style: none;
        }

        details > summary::-webkit-details-marker {
            display: none;
        }
    </style>
</head>


<body class="min-h-screen text-gray-800">

    <!-- ===================================================== -->
    <!-- CABEÇALHO                                             -->
    <!-- ===================================================== -->

    <div class="bg-white border-b border-gray-200 shadow-sm">

        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5"
        >

            <div
                class="flex flex-col md:flex-row md:items-center md:justify-between gap-4"
            >

                <div>

                    <h1
                        class="text-2xl font-bold text-gray-800"
                    >
                        <i
                            class="fas fa-clipboard-check text-blue-600 mr-2"
                        ></i>

                        Gerenciar Avaliações
                    </h1>


                    <p
                        class="text-sm text-gray-500 mt-1"
                    >
                        Feira:
                        <strong>
                            <%= feiraAtual?.nome || 'Feira' %>
                        </strong>
                    </p>

                </div>


                <a
                    href="/admin/dashboard?tab=relatorios"
                    class="inline-flex items-center justify-center px-4 py-2 bg-gray-700 hover:bg-gray-800 text-white rounded-lg shadow-sm transition"
                >

                    <i
                        class="fas fa-arrow-left mr-2"
                    ></i>

                    Voltar aos Relatórios

                </a>

            </div>

        </div>

    </div>


    <main
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8"
    >


        <!-- ================================================= -->
        <!-- MENSAGENS                                        -->
        <!-- ================================================= -->

        <% if (
            success_msg &&
            (
                Array.isArray(success_msg)
                    ? success_msg.length > 0
                    : success_msg
            )
        ) { %>

            <div
                class="mb-6 bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg"
            >

                <i
                    class="fas fa-check-circle mr-2"
                ></i>

                <%= Array.isArray(success_msg)
                    ? success_msg[0]
                    : success_msg %>

            </div>

        <% } %>


        <% if (
            error_msg &&
            (
                Array.isArray(error_msg)
                    ? error_msg.length > 0
                    : error_msg
            )
        ) { %>

            <div
                class="mb-6 bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg"
            >

                <i
                    class="fas fa-exclamation-circle mr-2"
                ></i>

                <%= Array.isArray(error_msg)
                    ? error_msg[0]
                    : error_msg %>

            </div>

        <% } %>



        <!-- ================================================= -->
        <!-- CONTADORES                                       -->
        <!-- ================================================= -->

        <div
            class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6"
        >

            <!-- TOTAL -->

            <div
                class="bg-white rounded-xl border border-gray-200 shadow-sm p-5"
            >

                <div
                    class="flex items-center justify-between"
                >

                    <div>

                        <p
                            class="text-sm font-medium text-gray-500"
                        >
                            Total de Avaliações
                        </p>

                        <p
                            class="text-3xl font-bold text-gray-800 mt-1"
                        >
                            <%= totais?.total || 0 %>
                        </p>

                    </div>


                    <div
                        class="w-12 h-12 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center"
                    >

                        <i
                            class="fas fa-clipboard-list text-xl"
                        ></i>

                    </div>

                </div>

            </div>


            <!-- VÁLIDAS -->

            <div
                class="bg-white rounded-xl border border-gray-200 shadow-sm p-5"
            >

                <div
                    class="flex items-center justify-between"
                >

                    <div>

                        <p
                            class="text-sm font-medium text-gray-500"
                        >
                            Avaliações Válidas
                        </p>

                        <p
                            class="text-3xl font-bold text-green-700 mt-1"
                        >
                            <%= totais?.validas || 0 %>
                        </p>

                    </div>


                    <div
                        class="w-12 h-12 rounded-full bg-green-100 text-green-600 flex items-center justify-center"
                    >

                        <i
                            class="fas fa-check-circle text-xl"
                        ></i>

                    </div>

                </div>

            </div>


            <!-- ANULADAS -->

            <div
                class="bg-white rounded-xl border border-gray-200 shadow-sm p-5"
            >

                <div
                    class="flex items-center justify-between"
                >

                    <div>

                        <p
                            class="text-sm font-medium text-gray-500"
                        >
                            Avaliações Anuladas
                        </p>

                        <p
                            class="text-3xl font-bold text-red-700 mt-1"
                        >
                            <%= totais?.anuladas || 0 %>
                        </p>

                    </div>


                    <div
                        class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center"
                    >

                        <i
                            class="fas fa-ban text-xl"
                        ></i>

                    </div>

                </div>

            </div>

        </div>



        <!-- ================================================= -->
        <!-- FILTROS                                          -->
        <!-- ================================================= -->

        <div
            class="bg-white rounded-xl border border-gray-200 shadow-sm p-5 mb-6"
        >

            <div
                class="flex items-center justify-between mb-4"
            >

                <div>

                    <h2
                        class="text-lg font-bold text-gray-800"
                    >
                        <i
                            class="fas fa-filter text-blue-600 mr-2"
                        ></i>

                        Filtros
                    </h2>

                    <p
                        class="text-sm text-gray-500 mt-1"
                    >
                        Localize rapidamente uma avaliação específica.
                    </p>

                </div>

            </div>


            <form
                method="GET"
                action="/admin/avaliacoes/gerenciar"
                class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end"
            >


                <!-- AVALIADOR -->

                <div>

                    <label
                        for="avaliadorId"
                        class="block text-sm font-semibold text-gray-700 mb-1"
                    >
                        Avaliador
                    </label>


                    <select
                        id="avaliadorId"
                        name="avaliadorId"
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                    >

                        <option value="">
                            Todos os avaliadores
                        </option>


                        <% avaliadores.forEach(avaliador => { %>

                            <option
                                value="<%= avaliador._id %>"
                                <%= String(filtros?.avaliadorId || '') === String(avaliador._id) ? 'selected' : '' %>
                            >

                                <%= avaliador.nome %>

                            </option>

                        <% }); %>

                    </select>

                </div>



                <!-- PROJETO -->

                <div>

                    <label
                        for="projetoId"
                        class="block text-sm font-semibold text-gray-700 mb-1"
                    >
                        Projeto
                    </label>


                    <select
                        id="projetoId"
                        name="projetoId"
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                    >

                        <option value="">
                            Todos os projetos
                        </option>


                        <% projetos.forEach(projeto => { %>

                            <option
                                value="<%= projeto._id %>"
                                <%= String(filtros?.projetoId || '') === String(projeto._id) ? 'selected' : '' %>
                            >

                                <% if (
                                    projeto.numeroEstande !== undefined &&
                                    projeto.numeroEstande !== null &&
                                    projeto.numeroEstande !== ''
                                ) { %>

                                    Estande
                                    <%= projeto.numeroEstande %>
                                    -

                                <% } %>

                                <%= projeto.titulo %>

                            </option>

                        <% }); %>

                    </select>

                </div>



                <!-- STATUS -->

                <div>

                    <label
                        for="status"
                        class="block text-sm font-semibold text-gray-700 mb-1"
                    >
                        Status
                    </label>


                    <select
                        id="status"
                        name="status"
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                    >

                        <option
                            value=""
                            <%= !filtros?.status ? 'selected' : '' %>
                        >
                            Todas
                        </option>


                        <option
                            value="valida"
                            <%= filtros?.status === 'valida' ? 'selected' : '' %>
                        >
                            Válidas
                        </option>


                        <option
                            value="anulada"
                            <%= filtros?.status === 'anulada' ? 'selected' : '' %>
                        >
                            Anuladas
                        </option>

                    </select>

                </div>



                <!-- BOTÕES -->

                <div
                    class="flex gap-2"
                >

                    <button
                        type="submit"
                        class="flex-1 inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-semibold shadow-sm"
                    >

                        <i
                            class="fas fa-search mr-2"
                        ></i>

                        Filtrar

                    </button>


                    <a
                        href="/admin/avaliacoes/gerenciar"
                        class="inline-flex items-center justify-center bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-semibold border border-gray-300"
                        title="Limpar filtros"
                    >

                        <i
                            class="fas fa-eraser"
                        ></i>

                    </a>

                </div>

            </form>

        </div>



        <!-- ================================================= -->
        <!-- AVISO                                            -->
        <!-- ================================================= -->

        <div
            class="mb-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4"
        >

            <div
                class="flex items-start"
            >

                <i
                    class="fas fa-shield-alt text-yellow-600 mt-1 mr-3"
                ></i>

                <div>

                    <p
                        class="font-semibold text-yellow-800"
                    >
                        Avaliações anuladas permanecem no histórico
                    </p>

                    <p
                        class="text-sm text-yellow-700 mt-1"
                    >
                        A anulação não exclui notas nem comentários.
                        A avaliação apenas deixa de participar de médias,
                        rankings e resultados oficiais.
                    </p>

                </div>

            </div>

        </div>



        <!-- ================================================= -->
        <!-- TABELA                                           -->
        <!-- ================================================= -->

        <div
            class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden"
        >

            <div
                class="px-5 py-4 border-b border-gray-200 flex flex-col md:flex-row md:items-center md:justify-between gap-2"
            >

                <div>

                    <h2
                        class="text-lg font-bold text-gray-800"
                    >
                        Avaliações encontradas
                    </h2>

                    <p
                        class="text-sm text-gray-500"
                    >
                        <%= avaliacoes.length %>
                        registro(s) correspondente(s) aos filtros.
                    </p>

                </div>

            </div>


            <% if (
                avaliacoes &&
                avaliacoes.length > 0
            ) { %>


                <div
                    class="overflow-x-auto"
                >

                    <table
                        class="tabela-avaliacoes min-w-full divide-y divide-gray-200"
                    >

                        <thead
                            class="bg-gray-50"
                        >

                            <tr>

                                <th
                                    class="px-4 py-3 text-left text-xs font-bold text-gray-600 uppercase"
                                >
                                    Avaliador
                                </th>

                                <th
                                    class="px-4 py-3 text-left text-xs font-bold text-gray-600 uppercase"
                                >
                                    Projeto
                                </th>

                                <th
                                    class="px-4 py-3 text-center text-xs font-bold text-gray-600 uppercase"
                                >
                                    Data
                                </th>

                                <th
                                    class="px-4 py-3 text-center text-xs font-bold text-gray-600 uppercase"
                                >
                                    Status
                                </th>

                                <th
                                    class="px-4 py-3 text-center text-xs font-bold text-gray-600 uppercase"
                                >
                                    Ação
                                </th>

                            </tr>

                        </thead>


                        <tbody
                            class="divide-y divide-gray-200"
                        >


                            <% avaliacoes.forEach(avaliacao => { %>

                                <%

                                    const anulada =
                                        avaliacao.status ===
                                        'anulada';


                                    const nomeAvaliador =
                                        avaliacao.avaliador &&
                                        avaliacao.avaliador.nome
                                            ? avaliacao.avaliador.nome
                                            : 'Avaliador removido';


                                    const emailAvaliador =
                                        avaliacao.avaliador &&
                                        avaliacao.avaliador.email
                                            ? avaliacao.avaliador.email
                                            : '';


                                    const tituloProjeto =
                                        avaliacao.projeto &&
                                        avaliacao.projeto.titulo
                                            ? avaliacao.projeto.titulo
                                            : 'Projeto removido';


                                    const numeroEstande =
                                        avaliacao.projeto &&
                                        avaliacao.projeto.numeroEstande !== undefined &&
                                        avaliacao.projeto.numeroEstande !== null &&
                                        avaliacao.projeto.numeroEstande !== ''
                                            ? avaliacao.projeto.numeroEstande
                                            : null;


                                    const dataAvaliacao =
                                        avaliacao.createdAt
                                            ? new Date(
                                                avaliacao.createdAt
                                            ).toLocaleString(
                                                'pt-BR',
                                                {
                                                    day:
                                                        '2-digit',

                                                    month:
                                                        '2-digit',

                                                    year:
                                                        'numeric',

                                                    hour:
                                                        '2-digit',

                                                    minute:
                                                        '2-digit'
                                                }
                                            )
                                            : '-';

                                %>


                                <tr
                                    class="<%= anulada ? 'bg-red-50' : 'hover:bg-gray-50' %>"
                                >


                                    <!-- AVALIADOR -->

                                    <td
                                        class="px-4 py-3"
                                    >

                                        <div
                                            class="font-semibold text-gray-800"
                                        >
                                            <%= nomeAvaliador %>
                                        </div>


                                        <% if (emailAvaliador) { %>

                                            <div
                                                class="text-xs text-gray-500 mt-1"
                                            >
                                                <%= emailAvaliador %>
                                            </div>

                                        <% } %>

                                    </td>



                                    <!-- PROJETO -->

                                    <td
                                        class="px-4 py-3"
                                    >

                                        <div
                                            class="font-medium text-gray-800"
                                        >
                                            <%= tituloProjeto %>
                                        </div>


                                        <% if (
                                            numeroEstande !== null
                                        ) { %>

                                            <div
                                                class="text-xs text-gray-500 mt-1"
                                            >

                                                Estande:
                                                <strong>
                                                    <%= numeroEstande %>
                                                </strong>

                                            </div>

                                        <% } %>

                                    </td>



                                    <!-- DATA -->

                                    <td
                                        class="px-4 py-3 text-sm text-gray-600 text-center whitespace-nowrap"
                                    >

                                        <%= dataAvaliacao %>

                                    </td>



                                    <!-- STATUS -->

                                    <td
                                        class="px-4 py-3 text-center"
                                    >

                                        <% if (anulada) { %>

                                            <span
                                                class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-800"
                                            >

                                                <i
                                                    class="fas fa-ban mr-1"
                                                ></i>

                                                ANULADA

                                            </span>

                                        <% } else { %>

                                            <span
                                                class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800"
                                            >

                                                <i
                                                    class="fas fa-check-circle mr-1"
                                                ></i>

                                                VÁLIDA

                                            </span>

                                        <% } %>

                                    </td>



                                    <!-- AÇÃO -->

                                    <td
                                        class="px-4 py-3 text-center"
                                    >


                                        <% if (!anulada) { %>


                                            <details
                                                class="inline-block text-left"
                                            >

                                                <summary
                                                    class="cursor-pointer inline-flex items-center bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-3 py-2 rounded-md shadow-sm"
                                                >

                                                    <i
                                                        class="fas fa-ban mr-1"
                                                    ></i>

                                                    Anular

                                                </summary>


                                                <div
                                                    class="mt-2 p-3 bg-white border border-red-200 rounded-lg shadow-lg w-80"
                                                >

                                                    <form
                                                        method="POST"
                                                        action="/admin/avaliacoes/<%= avaliacao._id %>/anular"
                                                    >

                                                        <label
                                                            class="block text-xs font-semibold text-gray-700 mb-2"
                                                        >
                                                            Motivo da anulação
                                                        </label>


                                                        <textarea
                                                            name="motivoAnulacao"
                                                            required
                                                            minlength="3"
                                                            rows="3"
                                                            class="w-full border border-gray-300 rounded-md p-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-500"
                                                            placeholder="Informe o motivo da anulação..."
                                                        ></textarea>


                                                        <p
                                                            class="text-xs text-red-600 mt-2 mb-3"
                                                        >
                                                            O registro permanecerá
                                                            disponível para auditoria.
                                                        </p>


                                                        <button
                                                            type="submit"
                                                            class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-3 rounded-md text-sm"
                                                            onclick="return confirm('Confirma a anulação desta avaliação?');"
                                                        >

                                                            <i
                                                                class="fas fa-ban mr-1"
                                                            ></i>

                                                            Confirmar Anulação

                                                        </button>

                                                    </form>

                                                </div>

                                            </details>


                                        <% } else { %>


                                            <div
                                                class="text-left inline-block max-w-xs"
                                            >


                                                <% if (
                                                    avaliacao.motivoAnulacao
                                                ) { %>

                                                    <div
                                                        class="text-xs text-gray-700 mb-2"
                                                    >

                                                        <strong>
                                                            Motivo:
                                                        </strong>

                                                        <%= avaliacao.motivoAnulacao %>

                                                    </div>

                                                <% } %>


                                                <% if (
                                                    avaliacao.anuladaEm
                                                ) { %>

                                                    <div
                                                        class="text-xs text-gray-500 mb-2"
                                                    >

                                                        <strong>
                                                            Anulada em:
                                                        </strong>

                                                        <%= new Date(
                                                            avaliacao.anuladaEm
                                                        ).toLocaleString(
                                                            'pt-BR',
                                                            {
                                                                day:
                                                                    '2-digit',

                                                                month:
                                                                    '2-digit',

                                                                year:
                                                                    'numeric',

                                                                hour:
                                                                    '2-digit',

                                                                minute:
                                                                    '2-digit'
                                                            }
                                                        ) %>

                                                    </div>

                                                <% } %>


                                                <form
                                                    method="POST"
                                                    action="/admin/avaliacoes/<%= avaliacao._id %>/restaurar"
                                                    onsubmit="return confirm('Deseja restaurar esta avaliação? Ela voltará a participar dos resultados.');"
                                                >

                                                    <button
                                                        type="submit"
                                                        class="inline-flex items-center bg-green-600 hover:bg-green-700 text-white text-xs font-semibold px-3 py-2 rounded-md shadow-sm"
                                                    >

                                                        <i
                                                            class="fas fa-undo-alt mr-1"
                                                        ></i>

                                                        Restaurar

                                                    </button>

                                                </form>

                                            </div>


                                        <% } %>


                                    </td>

                                </tr>

                            <% }); %>


                        </tbody>

                    </table>

                </div>


            <% } else { %>


                <div
                    class="p-10 text-center"
                >

                    <i
                        class="fas fa-search text-4xl text-gray-300 mb-4"
                    ></i>


                    <p
                        class="text-gray-600 font-semibold"
                    >
                        Nenhuma avaliação encontrada.
                    </p>


                    <p
                        class="text-sm text-gray-500 mt-1"
                    >
                        Altere os filtros ou limpe a pesquisa.
                    </p>

                </div>


            <% } %>

        </div>


    </main>

</body>

</html>
